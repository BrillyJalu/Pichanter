# Opsional. Salin menjadi ~/pichanter/.env di server bila ingin mengubah nilai bawaan. JANGAN di-commit.

# Alamat & port di host. Bawaan 172.17.0.1:8010 (dijangkau cloudflared, tidak terbuka ke LAN).
# Ganti PICHANTER_BIND=0.0.0.0 agar bisa dibuka dari LAN (http://192.168.1.7:8010).
PICHANTER_BIND=172.17.0.1
PICHANTER_PORT=8010

# Jumlah thread inferensi dan lama penyimpanan foto.
MODEL_THREADS=4
RETENTION_HOURS=24
