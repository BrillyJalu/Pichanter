{
  "appId": "id.my.jalulabs.pichanter",
  "appName": "Pichanter",
  "webDir": "www",
  "server": {
    "url": "https://pichanter.jalulabs.my.id/app/",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
