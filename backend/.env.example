# Salin menjadi .env lalu sesuaikan. File .env TIDAK boleh di-commit.

# --- Model ---
MODEL_DIR=models
MODEL_FILE=pichanter_bg_fp16.tflite
MODEL_VERSION=unet-mnv3l-384-fp16-v2
MODEL_THREADS=4
# true = pakai model sementara bila file model belum ada; set false saat demo/produksi.
ALLOW_PLACEHOLDER=true

# --- Penyimpanan ---
STORAGE_DIR=storage
DB_PATH=storage/pichanter.db
RETENTION_HOURS=24
CLEANUP_INTERVAL_S=600

# --- Validasi & proses ---
MAX_UPLOAD_MB=25
MAX_PIXELS=120000000
PROCESS_MAX_SIDE=6000
FEATHER=1.5

# --- CORS (pisahkan dengan koma). "*" cukup untuk demo. ---
CORS_ORIGINS=*

# --- Fitur opsional Gemini via 9Router (tidak dipakai pada versi ini) ---
USE_GEMINI=false
ROUTER_BASE_URL=
ROUTER_API_KEY=
GEMINI_MODEL=
